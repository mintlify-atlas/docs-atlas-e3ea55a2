{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Space Mission",
  "theme": "aspen",
  "colors": {
    "primary": "#22d3ee",
    "dark": "#020617"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/apursley2012/space-mission"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/apursley2012/space-mission"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction", "quickstart"]
