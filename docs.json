          {
            "group": "Architecture",
            "pages": ["architecture/overview", "architecture/routing", "architecture/animation"]
          }
        ]
      },
      {
        "tab": "Pages & Components",
        "groups": [
          {
            "group": "Core Pages",
            "pages": [
              "pages/home",
              "pages/about",
              "pages/projects",
              "pages/skills",
              "pages/work"
            ]
          },
          {
            "group": "Content Pages",
            "pages": [
              "pages/case-studies",
              "pages/blog",
              "pages/testimonials",
              "pages/contact"
            ]
          },
          {
            "group": "Shared Components",
            "pages": [
              "components/navigation",
              "components/starfield",
              "components/orbit-system",
              "components/page-transition"
            ]
          }
        ]
      },
      {
        "tab": "Customization",
        "groups": [
          {
            "group": "Theming",
            "pages": ["customization/colors", "customization/typography", "customization/tailwind"]
          },
          {
            "group": "Content & Deployment",
            "pages": ["customization/content-data", "customization/deployment"]
          }
        ]
      }
    ]
